# DISHA Platform - Environment Configuration Example
# Copy this file to .env and fill in your local or production credentials.
# NEVER commit your actual .env file or real secrets to Git.

# ─── Server Configuration ───────────────────────────────────────────────────
# Use 'development' for local work, 'production' for live deployment
ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ─── URLs & Deployment Integration ──────────────────────────────────────────
# Frontend URL (e.g. https://disha-platform.vercel.app in production, http://localhost:5173 locally)
FRONTEND_URL=http://localhost:5173

# Backend URL (e.g. https://disha-platform.onrender.com in production, http://localhost:8000 locally)
BACKEND_URL=http://localhost:8000

# Allowed CORS Origins (comma-separated). Backend includes default local + Vercel domains.
ALLOWED_ORIGINS=https://disha-platform.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ─── MongoDB Configuration ──────────────────────────────────────────────────
# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/DISHA?retryWrites=true&w=majority
MONGO_DB=DISHA

# ─── JWT Authentication & Security ──────────────────────────────────────────
# Replace with a strong random 32+ character key in production
JWT_SECRET=disha-super-secret-jwt-key-2026-production-grade-sec-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OTP System Settings ────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── Cookie Configuration ───────────────────────────────────────────────────
COOKIE_NAME=refresh_token
# Set COOKIE_SECURE=true in production (HTTPS required)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/api/auth

# ─── Google OAuth2 Configuration ─────────────────────────────────────────────
# Required for Google One-Tap / OAuth Sign-in
# Google Cloud Console Authorized Redirect URIs must include:
# Local:      http://localhost:8000/api/auth/google/callback
# Production: https://disha-platform.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Set explicitly for your environment:
# For Local:      http://localhost:8000/api/auth/google/callback
# For Production: https://disha-platform.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── Outbound Email & OTP Delivery (Brevo HTTPS API - RECOMMENDED) ──────────
# Brevo (Sendinblue) Transactional HTTPS API (Works reliably on all cloud containers)
# 1. Sign up / log in to Brevo: https://app.brevo.com/
# 2. Get your API key: https://app.brevo.com/settings/keys/api
# 3. Add and verify your sender email under Senders & IP -> Senders: https://app.brevo.com/senders
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com
BREVO_SENDER_NAME=DISHA Platform

# ─── Legacy SMTP / Development Fallback ──────────────────────────────────────
# In local development, if BREVO_API_KEY is omitted, OTPs are printed to console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-verified-sender@gmail.com
# SMTP_PASSWORD=your-16-char-google-app-password
# SMTP_TLS=true
# SMTP_FROM=your-verified-sender@gmail.com

# ─── AI Pipeline Settings (Gemini) ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BATCH_SIZE=10
NEWS_RESULTS_PER_QUERY=25
GEMINI_CONFIDENCE_THRESHOLD=0.70
GEMINI_AUTO_VERIFY_THRESHOLD=0.90

# ─── Data Pipeline Settings ─────────────────────────────────────────────────
RISEQ_ENABLED=false
SACHET_ENABLED=true
