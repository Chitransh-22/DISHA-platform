# DISHA Platform - Environment Configuration Example
# Copy this file to .env and fill in your local or production credentials.

# ─── Server Configuration ───────────────────────────────────────────────────
ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ─── MongoDB Configuration ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/DISHA?retryWrites=true&w=majority
MONGO_DB=DISHA

# ─── JWT Authentication & Security ──────────────────────────────────────────
# Replace with a cryptographically secure key in production (min 32 chars)
JWT_SECRET=disha-super-secret-jwt-key-2026-production-grade-sec-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OTP System Settings ────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── Cookie Configuration ───────────────────────────────────────────────────
COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/api/auth

# ─── Frontend Integration & CORS ────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=https://disha-platform.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ─── Google OAuth2 / Gmail API (Optional) ───────────────────────────────────
GOOGLE_USER=your-verified-sender@gmail.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token

# ─── SMTP Alternative Email Configuration (Optional) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=no-reply@disha.gov.in

# ─── AI Pipeline Settings (Gemini) ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BATCH_SIZE=10
NEWS_RESULTS_PER_QUERY=25
GEMINI_CONFIDENCE_THRESHOLD=0.70
GEMINI_AUTO_VERIFY_THRESHOLD=0.90

# ─── Data Pipeline Settings ─────────────────────────────────────────────────
RISEQ_ENABLED=false
SACHET_ENABLED=true
